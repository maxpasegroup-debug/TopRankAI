DATABASE_URL="postgresql://toprank:toprank@localhost:5432/toprank_dev?schema=public"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-strong-random-secret"
NODE_ENV="development"

# AI guidance (optional). Without a key the app runs and AI text is disabled.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
AI_FEATURES_ENABLED="true"

# Image storage. Cloudinary is the active provider; leave all three blank to
# keep uploads disabled (the uploader says so and the rest of the site works).
#
# Find these in the Cloudinary console -> Dashboard -> Product Environment
# Credentials: Cloud name, API Key, API Secret. The secret stays server-side.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: pin a provider instead of auto-detecting Cloudinary then R2.
# STORAGE_PROVIDER="cloudinary"

# Cloudflare R2 (S3-compatible), optional production alternative. Credentials
# never reach the browser; uploads are proxied by the app. R2 needs a payment
# method on the Cloudflare account even for its free monthly allowance.
#
# R2_ACCOUNT_ID         Cloudflare dashboard -> R2 -> account ID (right sidebar).
# R2_ACCESS_KEY_ID      R2 -> Manage R2 API Tokens -> Create token (Object Read & Write).
# R2_SECRET_ACCESS_KEY  Shown once when the token is created.
# R2_BUCKET             Bucket name exactly as created in R2.
# R2_PUBLIC_BASE_URL    Public read URL for the bucket: the https://pub-....r2.dev
#                       development URL, or a custom domain connected to the bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Future integrations. Leave blank until the related phase implements them.
AI_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_KEY=""
PAYMENT_PROVIDER_SECRET=""
EMAIL_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_TOKEN=""
STORAGE_BUCKET=""
REDIS_URL=""
MONITORING_DSN=""
