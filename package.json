{
  "name": "toprank-level-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/production.mjs build",
    "start": "node scripts/production.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma7.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-test-admin": "tsx scripts/bootstrap-test-admin.ts",
    "db:reset-candidates": "tsx scripts/reset-candidates.ts",
    "districts:sync": "tsx scripts/sync-districts.ts",
    "import:syllabus": "tsx scripts/import-syllabus.ts",
    "import:pyq": "tsx scripts/import-pyq.ts",
    "syllabus:sync": "tsx scripts/sync-syllabus-library.ts",
    "generate:questions": "tsx scripts/generate-questions.ts",
    "generate:notes": "tsx scripts/generate-notes.ts",
    "notes:share": "tsx scripts/share-notes.ts",
    "questions:dedupe": "tsx scripts/dedupe-questions.ts",
    "questions:audit": "tsx scripts/audit-questions.ts",
    "verify:papers": "tsx scripts/verify-papers.ts",
    "verify:postgres:setup": "tsx verification/setup-postgres.ts",
    "verify:postgres:preflight": "tsx postgres-preflight.ts",
    "verify:postgres:migrate": "tsx verification/run-postgres.ts migrate",
    "verify:postgres:fixtures": "tsx verification/run-postgres.ts fixtures",
    "verify:infrastructure:typecheck": "tsc --project verification/tsconfig.json",
    "verify:postgres:stop": "tsx verification/stop-postgres.ts",
    "verify:postgres:finalize": "tsx verification/finalize-postgres.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.1",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
