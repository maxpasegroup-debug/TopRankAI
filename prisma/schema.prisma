// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  STUDENT
  PARENT
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LearningResourceType {
  VIDEO
  ARTICLE
  PDF
  NOTES
  EXTERNAL
  OTHER
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMERICAL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionReviewStatus {
  NEEDS_REVIEW
  REVIEWED
}

enum PreparationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXTREME
}

enum SyllabusProgressStatus {
  NOT_STARTED
  LEARNING
  COMPLETED
  NEEDS_REVISION
}

enum DailyExamStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  MISSED
  EXPIRED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AnswerStatus {
  CORRECT
  INCORRECT
  UNANSWERED
}

enum QuestionSourceType {
  AI_GENERATED
  PREVIOUS_YEAR
  ADMIN_CREATED
  SEED
}

enum RevisionStatus {
  PENDING
  COMPLETED
  DISMISSED
}

enum CalendarStatus {
  CONFIRMED
  TENTATIVE
  NOT_ANNOUNCED
}

enum CalendarEventType {
  APPLICATION_START
  APPLICATION_END
  ADMIT_CARD
  EXAM
  RESULT
  COUNSELLING
  OTHER
}

enum NotificationType {
  DAILY_EXAM
  MISSED_EXAM
  REVISION
  TARGET
  STREAK
  PERFORMANCE
  EXAM_DATE
  MOCK
  SYSTEM
  ACHIEVEMENT
}

enum GoalType {
  QUESTIONS
  TOPIC
  MOCK
  REVISION
  MINUTES
}

enum AchievementMetric {
  TESTS_COMPLETED
  STREAK
  ACCURACY
  QUESTIONS_SOLVED
  SYLLABUS_TOPICS
  PERFECT_SCORE
  MOCK_COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  pinHash      String?
  pinVersion   Int        @default(0)
  emailVerifiedAt DateTime?
  name         String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  dateOfBirth  DateTime?  @db.Date
  gender       String?
  state        String?
  city         String?
  education    String?
  currentEducationLevel String?
  preferredLanguage String @default("en")
  avatarUrl    String?
  dailyStudyMinutes Int   @default(60)
  timezone     String     @default("Asia/Kolkata")
  onboardingCompletedAt DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions             Session[]
  studentProfile       StudentProfile?
  studyPlans           StudyPlan[]
  studySessions        StudySession[]
  lessonProgress       StudentLessonProgress[]
  savedResources       StudentSavedResource[]
  practiceAttempts     PracticeAttempt[]
  practiceRevisions    PracticeRevisionState[]
  candidateExamTargets CandidateExamTarget[]
  mockAttempts         MockAttempt[]
  helpRequests         HelpRequest[]
  auditEvents          AuditEvent[]
  accountConsent AccountConsent?
  guardianRegistrationGrants GuardianRegistrationGrant[] @relation("RegistrationGuardian")
  issuedRegistrationGrants GuardianRegistrationGrant[] @relation("RegistrationVerifier")
  passwordResets PasswordReset[]
  otpChallenges EmailOtpChallenge[]
  authoredSyllabuses SyllabusVersion[] @relation("SyllabusAuthor")
  reviewedSyllabuses SyllabusVersion[] @relation("SyllabusReviewer")
  authoredContentSources ContentSource[] @relation("ContentSourceAuthor")
  reviewedContentSources ContentSource[] @relation("ContentSourceReviewer")
  requestedKnowledgeJobs ContentKnowledgeJob[]
  privacyRequestsMade AccountPrivacyRequest[] @relation("PrivacyRequester")
  privacyRequestsAbout AccountPrivacyRequest[] @relation("PrivacySubject")
  privacyRequestsReviewed AccountPrivacyRequest[] @relation("PrivacyReviewer")

  dailyExams          DailyExam[]
  examAttempts        ExamAttempt[]
  topicProgress       TopicProgress[]
  revisionQueue       RevisionQueue[]
  dailyGoals          DailyGoal[]
  performanceRecords  PerformanceRecord[]
  notifications       Notification[]
  mockPayments        MockPayment[]
  achievements        UserAchievement[]
  subscription        Subscription?
  aiUsageLogs         AIUsageLog[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtpChallenge {
  id String @id
  tokenHash String @unique
  purpose String
  email String
  bindingHash String?
  codeHash String
  proofHash String?
  userId String?
  pinVersion Int?
  deliveryState String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model PinAttemptWindow {
  id String @id
  count Int @default(0)
  endsAt DateTime
}

model GuardianRegistrationGrant {
  id String @id @default(cuid())
  tokenHash String @unique
  childEmailHash String
  country String
  policyVersion String
  guardianId String
  verifiedById String
  verificationReference String
  verifiedAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  guardian User @relation("RegistrationGuardian", fields: [guardianId], references: [id], onDelete: Restrict)
  verifiedBy User @relation("RegistrationVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  receipt AccountConsent?
  @@index([guardianId, revokedAt])
  @@index([expiresAt])
}

model AccountConsent {
  userId String @id
  country String
  ageBand String
  termsVersion String
  privacyVersion String
  acceptedAt DateTime @default(now())
  revokedAt DateTime?
  guardianGrantId String? @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianGrant GuardianRegistrationGrant? @relation(fields: [guardianGrantId], references: [id], onDelete: Restrict)
}

model PasswordReset {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  deliveryPayload String?
  deliveryState String @default("PENDING")
  deliveryAttempts Int @default(0)
  deliveryLeaseUntil DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([deliveryState, expiresAt])
}

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetExamId   String?
  targetYear     Int?
  dreamCollege   String?
  dailyStudyMins Int?
  onboardingCompletedAt DateTime?
  aspiration     String?
  targetScore    String?
  preparationStart DateTime? @db.Date
  focusSubjectIds String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetExam Exam? @relation(fields: [targetExamId], references: [id])

  @@index([targetExamId])
}

model ExamCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams Exam[]

  @@index([active, order])
}

model Exam {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  shortName String?
  status    ContentStatus @default(DRAFT)
  active    Boolean       @default(true)
  categoryId String?
  category   String      @default("OTHER")
  description String?
  officialUrl String?
  defaultPreparationLevel PreparationLevel @default(BEGINNER)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  examCategory    ExamCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  examSubjects    ExamSubject[]
  questionExams   QuestionExam[]
  studentProfiles StudentProfile[]
  studyPlans      StudyPlan[]
  missionTasks    MissionTask[]
  practiceAttempts PracticeAttempt[]
  mockExams        MockExam[]
  syllabusVersions SyllabusVersion[]
  candidateTargets CandidateExamTarget[]
  configuration   ExamConfiguration?
  syllabusUnits   SyllabusUnit[]
  dailyExams      DailyExam[]
  examAttempts    ExamAttempt[]
  revisionQueue   RevisionQueue[]
  dailyGoals      DailyGoal[]
  performanceRecords PerformanceRecord[]
  calendarEvents  ExamCalendar[]
  syllabusSources SyllabusSource[]

  @@index([status, active])
  @@index([categoryId, active])
  @@index([category, active])
}

model CandidateExamTarget {
  id                String           @id @default(cuid())
  userId            String
  examId            String
  targetYear        Int
  preparationLevel  PreparationLevel @default(BEGINNER)
  dailyPaperCount   Int?
  dailyStartMinutes Int              @default(480)
  dailyMinutes      Int              @default(45)
  examPart          String?
  targetExamDate    DateTime?        @db.Date
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam  @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@unique([userId, examId, targetYear])
  @@index([userId, active, targetYear])
  @@index([examId, targetYear])
}

model Subject {
  id        String        @id @default(cuid())
  code      String?       @unique
  name      String
  slug      String        @unique
  status    ContentStatus @default(DRAFT)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  examSubjects ExamSubject[]
  chapters     Chapter[]
  questions    Question[]
  syllabusUnits SyllabusUnit[]
  syllabusSources SyllabusSource[]

  @@index([status, active])
}

model ExamSubject {
  id        String   @id @default(cuid())
  examId    String
  subjectId String
  order     Int      @default(0)
  status    ContentStatus @default(PUBLISHED)
  active    Boolean       @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId])
  @@index([subjectId])
  @@index([status, active])
}

model Chapter {
  id        String        @id @default(cuid())
  subjectId String
  title     String
  slug      String
  summary   String?
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  questions Question[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([status, active])
}

model Lesson {
  id        String        @id @default(cuid())
  chapterId String
  title     String
  slug      String
  summary   String?
  body      Json?
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  chapter   Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  resources LearningResource[]
  questions Question[]
  studentProgress StudentLessonProgress[]

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@index([status, active])
}

model LearningResource {
  id        String               @id @default(cuid())
  lessonId  String
  title     String
  slug      String
  type      LearningResourceType @default(OTHER)
  url       String?
  reference String?
  order     Int                  @default(0)
  status    ContentStatus        @default(DRAFT)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  savedBy StudentSavedResource[]

  @@unique([lessonId, slug])
  @@index([lessonId])
  @@index([status, active])
}

model ContentEditorialRecord {
  entity String
  entityId String
  revision Int @default(1)
  authorId String
  reviewerId String?
  reviewedRevision Int?
  reviewedFingerprint String?
  reviewEvidence String?
  reviewedAt DateTime?
  updatedAt DateTime @updatedAt

  @@id([entity, entityId])
}

model SyllabusVersion {
  id String @id @default(cuid())
  examId String
  label String
  sourceUrl String
  evidence String
  effectiveFrom DateTime?
  supersedesId String?
  outline Json
  state String @default("DRAFT")
  authorId String
  reviewerId String?
  reviewedAt DateTime?
  decision String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  author User @relation("SyllabusAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer User? @relation("SyllabusReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  supersedes SyllabusVersion? @relation("SyllabusSuccession", fields: [supersedesId], references: [id], onDelete: Restrict)
  successors SyllabusVersion[] @relation("SyllabusSuccession")
  @@unique([examId, label])
  @@index([state, examId])
}

model ContentSource {
  id String @id @default(cuid())
  entity String
  entityId String
  title String
  url String?
  rightsHolder String
  origin String
  licence String
  attribution String
  permissionEvidence String
  authorId String
  reviewerId String?
  reviewedAt DateTime?
  contentFingerprint String
  siaIncluded Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs ContentKnowledgeJob[]
  author User @relation("ContentSourceAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ContentSourceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  @@unique([entity, entityId])
}

model ContentKnowledgeJob {
  id String @id @default(cuid())
  sourceId String
  fingerprint String
  state String @default("BLOCKED")
  reason String
  requestedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  source ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  requestedBy User @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  @@unique([sourceId, fingerprint])
  @@index([state, createdAt])
}

model StudentSavedResource {
  userId String
  resourceId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@index([resourceId])
}

model Question {
  id            String               @id @default(cuid())
  code          String               @unique
  text          String
  type          QuestionType
  difficulty    QuestionDifficulty   @default(MEDIUM)
  status        ContentStatus        @default(DRAFT)
  active        Boolean              @default(true)
  subjectId     String
  chapterId     String?
  lessonId      String?
  topicId       String?
  explanation   String?
  solutionRef   String?
  numericalAnswer String?
  supersedesId  String?
  source        String?
  sourceYear    Int?
  sourceType    QuestionSourceType   @default(ADMIN_CREATED)
  marks         Decimal              @default(4) @db.Decimal(5, 2)
  negativeMarks Decimal              @default(1) @db.Decimal(5, 2)
  syllabusRef   String?
  checksum      String?              @unique
  aiJobId       String?
  approvedAt    DateTime?
  approvedById  String?
  language      String               @default("en")
  reviewStatus  QuestionReviewStatus @default(NEEDS_REVIEW)
  tags          String[]             @default([])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  subject Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapter Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  lesson  Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  topic   SyllabusTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  options QuestionOption[]
  exams   QuestionExam[]
  attempts PracticeAttempt[]
  revisionStates PracticeRevisionState[]
  supersedes Question? @relation("QuestionSuccession", fields: [supersedesId], references: [id], onDelete: Restrict)
  successors Question[] @relation("QuestionSuccession")
  userAnswers UserAnswer[]
  revisionItems RevisionQueue[]

  @@index([subjectId])
  @@index([chapterId])
  @@index([lessonId])
  @@index([topicId])
  @@index([type])
  @@index([difficulty])
  @@index([supersedesId])
  @@index([status, active])
  @@index([sourceType])
}

model QuestionOption {
  id         String   @id @default(cuid())
  code       String
  questionId String
  text       String
  order      Int      @default(0)
  isCorrect  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, code])
  @@index([questionId])
  @@index([active])
}

model QuestionExam {
  id            String        @id @default(cuid())
  questionId    String
  examId        String
  status        ContentStatus @default(PUBLISHED)
  active        Boolean       @default(true)
  marks         Decimal       @default(4) @db.Decimal(5, 2)
  negativeMarks Decimal       @default(1) @db.Decimal(5, 2)
  scoringMode   PracticeScoringMode?
  sourceYear    Int?
  category      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([questionId, examId])
  @@index([examId])
  @@index([questionId])
  @@index([status, active])
}

enum MissionTaskStatus {
  TODO
  COMPLETED
  SKIPPED
}

model StudyPlan {
  id           String @id @default(cuid())
  userId       String
  examId       String
  title        String
  active       Boolean @default(true)
  startDate    DateTime @db.Date
  dailyMinutes Int
  requestKey   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  tasks        MissionTask[]
  @@unique([userId, requestKey])
  @@index([userId, active])
}

model MissionTask {
  id           String @id @default(cuid())
  planId       String
  examId       String?
  title        String
  subject      String
  href         String?
  dueDate      DateTime @db.Date
  minutes      Int
  status       MissionTaskStatus @default(TODO)
  completedAt  DateTime?
  version      Int @default(0)
  requestKey   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plan         StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exam         Exam? @relation(fields: [examId], references: [id], onDelete: Restrict)
  events       MissionTaskEvent[]
  mockRevision MockAnswer?
  studySessions StudySession[]
  @@unique([planId, requestKey])
  @@index([planId, dueDate])
  @@index([examId, dueDate])
}

model MissionTaskEvent {
  id        String @id @default(cuid())
  taskId    String
  status    MissionTaskStatus
  dueDate   DateTime @db.Date
  createdAt DateTime @default(now())
  task      MissionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
}

model StudySession {
  id        String @id @default(cuid())
  userId    String
  requestKey String
  topic     String
  taskId    String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      MissionTask? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@unique([userId, requestKey])
  @@index([userId, startedAt])
}

enum PracticeScoringMode {
  EXACT_SET
  DECIMAL_EXACT
}

enum HelpRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model HelpRequest {
  id        String @id @default(cuid())
  userId    String
  requestKey String
  subject   String
  message   String
  status    HelpRequestStatus @default(OPEN)
  response  String?
  version   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AccountPrivacyRequest {
  id String @id @default(cuid())
  requesterId String
  subjectId String
  requestKey String
  kind String
  message String
  status String @default("OPEN")
  response String?
  completionReference String?
  followUp String?
  followUpKey String?
  reviewerId String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requester User @relation("PrivacyRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  subject User @relation("PrivacySubject", fields: [subjectId], references: [id], onDelete: Restrict)
  reviewer User? @relation("PrivacyReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  @@unique([requesterId, requestKey])
  @@index([subjectId, status])
  @@index([status, createdAt, id])
}

model AuditEvent {
  id        String @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  detail    String?
  createdAt DateTime @default(now())
  actor     User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

model PracticeAttempt {
  id           String @id @default(cuid())
  userId       String
  questionId   String
  examId       String
  requestKey   String
  answer       Json
  correct      Boolean
  score        Decimal @db.Decimal(7, 2)
  maximumScore Decimal @db.Decimal(7, 2)
  scoringMode  PracticeScoringMode
  explanation  String?
  questionText String
  submittedAt  DateTime @default(now())
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  exam         Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  @@unique([userId, requestKey])
  @@index([userId, submittedAt])
  @@index([userId, questionId])
}

model PracticeRevisionState {
  userId String
  questionId String
  bookmarked Boolean @default(false)
  reviewedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@id([userId, questionId])
  @@index([userId, bookmarked])
}

model StudentLessonProgress {
  id          String @id @default(cuid())
  userId      String
  lessonId    String
  bookmarked  Boolean @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

enum MockAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model MockExam {
  id              String @id @default(cuid())
  examId          String
  title           String
  status          ContentStatus @default(DRAFT)
  version         Int @default(0)
  durationSeconds Int
  maxAttempts     Int
  revealPolicy    String
  sections        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  exam            Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  attempts        MockAttempt[]
  @@index([examId, status])
}

model MockAttempt {
  id          String @id @default(cuid())
  userId      String
  mockExamId  String
  requestKey  String
  status      MockAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime
  deadline    DateTime
  finalizedAt DateTime?
  snapshot    Json
  result      Json?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockExam    MockExam @relation(fields: [mockExamId], references: [id], onDelete: Restrict)
  answers     MockAnswer[]
  @@unique([userId, requestKey])
  @@index([userId, startedAt])
  @@index([userId, mockExamId, status])
}

model MockAnswer {
  id             String @id @default(cuid())
  attemptId      String
  position       Int
  answer         Json
  version        Int @default(0)
  flagged        Boolean @default(false)
  bookmarked     Boolean @default(false)
  reviewedAt     DateTime?
  revisionTaskId String? @unique
  attempt        MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  revisionTask   MissionTask? @relation(fields: [revisionTaskId], references: [id], onDelete: SetNull)
  @@unique([attemptId, position])
}

// ---------------------------------------------------------------------------
// AI-powered continuous examination platform
// ---------------------------------------------------------------------------

model ExamConfiguration {
  id                    String   @id @default(cuid())
  examId                String   @unique
  durationMinutes       Int      @default(60)
  totalQuestions        Int      @default(30)
  sections              Json     @default("[]")
  positiveMarks         Decimal  @default(1) @db.Decimal(5, 2)
  negativeMarks         Decimal  @default(0) @db.Decimal(5, 2)
  questionTypes         String[] @default(["SINGLE_CHOICE"])
  dailyTestQuestions    Int      @default(8)
  dailyTestMinutes      Int      @default(12)
  dailyTestCount        Json     @default("{\"BEGINNER\":1,\"INTERMEDIATE\":2,\"ADVANCED\":3,\"EXTREME\":4}")
  markingNote           String?
  sourceUrl             String?
  verifiedAt            DateTime?
  version               Int      @default(1)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([active])
}

model SyllabusUnit {
  id          String   @id @default(cuid())
  examId      String
  subjectId   String
  title       String
  slug        String
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapters SyllabusChapter[]

  @@unique([examId, subjectId, slug])
  @@index([examId, subjectId, order])
  @@index([active])
}

model SyllabusChapter {
  id          String   @id @default(cuid())
  unitId      String
  title       String
  slug        String
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit   SyllabusUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topics SyllabusTopic[]

  @@unique([unitId, slug])
  @@index([unitId, order])
  @@index([active])
}

model SyllabusTopic {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  slug        String
  description String?
  content     String?
  formulas    String?
  examples    String?
  difficulty  QuestionDifficulty @default(MEDIUM)
  estimatedMinutes Int @default(30)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter      SyllabusChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  materials    StudyMaterial[]
  progress     TopicProgress[]
  questions    Question[]
  revisionQueue RevisionQueue[]

  @@unique([chapterId, slug])
  @@index([chapterId, order])
  @@index([active])
}

model StudyMaterial {
  id        String   @id @default(cuid())
  topicId   String
  title     String
  type      LearningResourceType @default(NOTES)
  url       String?
  content   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

model TopicProgress {
  id            String   @id @default(cuid())
  userId        String
  topicId       String
  status        SyllabusProgressStatus @default(NOT_STARTED)
  completion    Int      @default(0)
  bookmarked    Boolean  @default(false)
  notes         String?
  lastStudiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, status])
}

model DailyExam {
  id             String   @id @default(cuid())
  userId         String
  examId         String
  scheduledDate  DateTime @db.Date
  slot           Int      @default(0)
  title          String
  status         DailyExamStatus @default(SCHEDULED)
  questionIds    String[] @default([])
  configSnapshot Json     @default("{}")
  durationMinutes Int     @default(15)
  totalMarks     Decimal  @default(0) @db.Decimal(7, 2)
  negativeMarks  Decimal  @default(0) @db.Decimal(7, 2)
  aiGeneratedCount Int    @default(0)
  startedAt      DateTime?
  submittedAt    DateTime?
  missedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempt ExamAttempt?

  @@unique([userId, examId, scheduledDate, slot])
  @@index([userId, scheduledDate, status])
  @@index([examId, scheduledDate])
}

model ExamAttempt {
  id              String   @id @default(cuid())
  dailyExamId     String   @unique
  userId          String
  examId          String
  status          ExamAttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime @default(now())
  deadline        DateTime
  submittedAt     DateTime?
  timeTakenSeconds Int     @default(0)
  totalMarks      Decimal  @default(0) @db.Decimal(7, 2)
  obtainedMarks   Decimal  @default(0) @db.Decimal(7, 2)
  correctCount    Int      @default(0)
  incorrectCount  Int      @default(0)
  unansweredCount Int      @default(0)
  negativeMarks   Decimal  @default(0) @db.Decimal(7, 2)
  accuracy        Decimal  @default(0) @db.Decimal(5, 2)
  scorePercent    Decimal  @default(0) @db.Decimal(5, 2)
  subjectBreakdown Json    @default("{}")
  topicBreakdown  Json     @default("{}")
  aiFeedback      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dailyExam DailyExam @relation(fields: [dailyExamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers   UserAnswer[]

  @@index([userId, submittedAt])
  @@index([userId, examId, status])
}

model UserAnswer {
  id           String   @id @default(cuid())
  attemptId    String
  questionId   String
  position     Int
  selected     Json     @default("[]")
  status       AnswerStatus @default(UNANSWERED)
  marksAwarded Decimal  @default(0) @db.Decimal(7, 2)
  timeSpentSeconds Int  @default(0)
  flagged      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([questionId])
}

model RevisionQueue {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  questionId  String?
  topicId     String?
  reason      String
  dueDate     DateTime @db.Date
  status      RevisionStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  topic    SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueDate])
  @@index([examId, dueDate])
}

model DailyGoal {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  goalDate    DateTime @db.Date
  type        GoalType
  title       String
  target      Int      @default(1)
  progress    Int      @default(0)
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, goalDate, title])
  @@index([userId, goalDate])
}

model PerformanceRecord {
  id              String   @id @default(cuid())
  userId          String
  examId          String
  recordDate      DateTime @db.Date
  testsAttended   Int      @default(0)
  totalQuestions  Int      @default(0)
  correct         Int      @default(0)
  incorrect       Int      @default(0)
  unanswered      Int      @default(0)
  marksObtained   Decimal  @default(0) @db.Decimal(8, 2)
  marksTotal      Decimal  @default(0) @db.Decimal(8, 2)
  accuracy        Decimal  @default(0) @db.Decimal(5, 2)
  studyMinutes    Int      @default(0)
  goalsCompleted  Int      @default(0)
  goalsTotal      Int      @default(0)
  streak          Int      @default(0)
  syllabusCompletion Decimal @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, recordDate])
  @@index([userId, recordDate])
  @@index([examId, recordDate])
}

model ExamCalendar {
  id          String   @id @default(cuid())
  examId      String
  eventType   CalendarEventType @default(EXAM)
  title       String
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  status      CalendarStatus @default(NOT_ANNOUNCED)
  sourceUrl   String?
  sourceLabel String?
  verifiedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, startDate])
  @@index([startDate, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model AchievementDefinition {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  icon        String   @default("award")
  metric      AchievementMetric
  threshold   Int
  xp          Int      @default(50)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  awards UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  examId        String?
  earnedAt      DateTime @default(now())
  progress      Int      @default(0)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, earnedAt])
}

model MockPayment {
  id          String   @id
  userId      String
  plan        String
  amountPaise Int
  currency    String   @default("INR")
  status      String
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  plan        String   @default("FREE")
  status      SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime?
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  features    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
}

model AIUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  examId       String?
  provider     String
  model        String
  operation    String
  success      Boolean  @default(true)
  latencyMs    Int      @default(0)
  promptChars  Int      @default(0)
  responseChars Int     @default(0)
  error        String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([operation, createdAt])
  @@index([createdAt])
}

enum SyllabusSourceKind {
  SYLLABUS
  PYQ
}

enum SyllabusSourceStatus {
  PENDING
  IMPORTED
  FAILED
}

/// Raw official documents (syllabus pages, brochures, previous-year papers)
/// captured by the import pipeline. Keeping the source text next to its URL
/// makes every AI-generated question traceable to a real official reference.
model SyllabusSource {
  id        String   @id @default(cuid())
  examId    String
  subjectId String?
  label     String
  url       String
  kind      SyllabusSourceKind   @default(SYLLABUS)
  format    String   @default("HTML")
  content   String?
  status    SyllabusSourceStatus @default(PENDING)
  error     String?
  fetchedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([examId, url])
  @@index([examId, status])
  @@index([kind, status])
}
