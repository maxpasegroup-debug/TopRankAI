# Independently provisioned private environment; not authorized for deployment.
TOPRANK_ENVIRONMENT=staging
DATABASE_URL=<APPROVED_ISOLATED_STAGING_DATABASE_URL>
APP_URL=https://<APPROVED_PRIVATE_STAGING_HOST>
NODE_ENV=production
AUTH_RATE_LIMIT_ACTIVATED=false
AUTH_RATE_LIMIT_LIVE_VERIFIED=false
AUTH_TRUSTED_PROXY_VERIFIED=false
ACCOUNT_POLICY_REVIEWED=false
ACCOUNT_GUARDIAN_VERIFICATION_APPROVED=false
AUTH_RECOVERY_DELIVERY_VERIFIED=false
ACCOUNT_PRIVACY_PROCESSING_APPROVED=false
AUTH_PIN_ENABLED=false
AUTH_PIN_EMAIL_VERIFIED=false
AUTH_PIN_HMAC_KEY=<DEDICATED_RANDOM_32_BYTE_OR_LONGER_SECRET>
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_FROM=<VERIFIED_SENDING_EMAIL>
RESEND_API_KEY=<SERVER_ONLY_SENDING_KEY>
